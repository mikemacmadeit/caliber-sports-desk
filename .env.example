# Caliber — private research configuration
# Copy to .env. Never expose keys to the Next.js client.

APP_ENV=dev
APP_NAME=Caliber
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separate multiple frontends in cloud, e.g.
# WEB_ORIGIN=https://your-site.netlify.app,http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# SQLite for local prototype; Postgres in Docker / Render:
# DATABASE_URL=postgresql+psycopg://caliber:caliber@localhost:5432/caliber
DATABASE_URL=sqlite:///./data/caliber.db

# Website → API (Netlify). Set both to the Render API URL in production.
# API_URL=https://caliber-api.onrender.com
# NEXT_PUBLIC_API_URL=https://caliber-api.onrender.com

# Object storage for simulation draws (local path for MVP)
PARQUET_DIR=./data/parquet

# --- Provider keys (server-side only) ---
# nflverse historical parquet: no key (CC-BY). Worker: ingest-nfl --start 2016 --end 2025
# CollegeFootballData: required for any NCAA FBS historical ingest.
# Tier 2 is ~$5/mo / 30k calls. https://collegefootballdata.com/api-tiers
CFBD_API_KEY=
# The Odds API live events need a key. Historical odds/player props are a paid add-on
# (player-prop history starts 2023-05-03). Do not invent missing ticks.
ODDS_API_KEY=

# Odds API credit ceiling. Credits are not HTTP requests.
# Measure empirically before widening markets/bookmakers/regions.
ODDS_CREDIT_BUDGET_PER_DAY=2000
ODDS_REGIONS=us
ODDS_BOOKMAKERS=draftkings,fanduel,betmgm,fanatics
ODDS_MARKETS=player_anytime_td,player_receptions,player_reception_yds,player_rush_yds

# NWS requires a unique User-Agent with contact info.
NWS_USER_AGENT=Caliber Private Research (dev@localhost)

# Open-Meteo free tier is CC BY 4.0 and noncommercial only.
# Commercial use requires a paid license: https://open-meteo.com/en/pricing
OPEN_METEO_ENABLED=false

# NOAA Climate Data Online. Free token from https://www.ncei.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=

# API-Sports football. Server-side only. https://www.api-football.com/documentation-v3
API_SPORTS_KEY=

# OpenAI Responses API. Server-side only. https://platform.openai.com/docs/api-reference/responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GDELT_LOOKBACK_DAYS=14

# Ingest cadence (seconds). Worker respects credit budget.
INGEST_ODDS_INTERVAL_SEC=1200
INGEST_INJURY_INTERVAL_SEC=2400
INGEST_WEATHER_INTERVAL_SEC=7200

# Recommendation thresholds (research defaults; not betting advice)
MIN_EV_AFTER_HAIRCUT=0.04
MAX_PRICE_AGE_MINUTES=45
MIN_AVAILABILITY_PROB=0.75
DISCLAIMER=Research forecast only. Not betting advice. No wagering, no automated placement.
